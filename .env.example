# SecureCam secrets
#
# The installer creates /etc/securecam/securecam.env from this template with
# mode 0600, owned by the securecam service user. Never commit a real .env file.
#
# systemd loads this file via EnvironmentFile=, so values must NOT be quoted
# unless the quotes are part of the value.

# ---------------------------------------------------------------------------
# Required - generated automatically by install.sh
# ---------------------------------------------------------------------------

# Signs API session tokens and stream tickets. Rotating it logs everyone out.
# Generate with: openssl rand -hex 32
SECURECAM_SECRET_KEY=

# Credentials MediaMTX-internal components use to talk to each other over
# localhost. Generated automatically; you normally never need to touch them.
SECURECAM_MEDIAMTX_SERVICE_USER=securecam-service
SECURECAM_MEDIAMTX_SERVICE_PASS=

# ---------------------------------------------------------------------------
# Optional - external AI person detection (ai.enabled: true)
# ---------------------------------------------------------------------------

# OpenAI-compatible vision endpoint key (provider: openai_vision)
SECURECAM_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional - notifications (notifications.enabled: true)
# ---------------------------------------------------------------------------

# ntfy access token, only needed for protected topics / self-hosted servers
SECURECAM_NTFY_TOKEN=

# Pushover application API token (the per-recipient user key goes in config.yaml)
SECURECAM_PUSHOVER_TOKEN=
